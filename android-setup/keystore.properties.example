# Copy this file to:  android/keystore.properties   (after running `npx cap add android`)
# Fill in the values you chose when running scripts/generate-keystore.sh.
# DO NOT COMMIT the real android/keystore.properties — keep it gitignored.

storeFile=../../android-keys/enovo-upload.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=enovo-upload
keyPassword=YOUR_KEY_PASSWORD
