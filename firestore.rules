rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: Check if user is admin ───────────────
    // SECURITY (H-04, 2026-09-02): admin status now comes from a Firebase Auth
    // custom claim ({ admin: true }), set by the onAdminConfigWritten Cloud
    // Function from the admin-only adminConfig/settings doc. Previously this
    // read appConfig/settings.adminEmails, a world-readable doc that exposed
    // the admin email list to everyone.
    function isAdminUser() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ─── Admin Config (admin email list) ──────────────
    // SECURITY (H-04, 2026-09-02): admin-only doc. The email list lives here
    // (not in world-readable appConfig). A Cloud Function syncs it to Auth
    // custom claims. Bootstrap the first admin doc via Firebase console.
    match /adminConfig/{docId} {
      allow read, write: if isAdminUser();
    }

    // ─── App Config (feature settings) ────────────────
    // Read allowed for all (needed for signup page to check KYC feature flags).
    // SECURITY (C3, 2026-07-05): write is ADMIN-ONLY — previously any
    // authenticated user could write it, a full privilege-escalation.
    // SECURITY (H-04, 2026-09-02): the admin email list moved to the
    // admin-only adminConfig/settings doc; a legacy `adminEmails` field may
    // linger here for old clients' UI gating until they update — it grants
    // nothing (rules + new clients check the auth custom claim instead).
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // ─── Users collection ─────────────────────────────
    // SECURITY (C-01, 2026-09-02): admins may list private profile subdocs
    // across all users (collection-group query used by the admin panel).
    match /{path=**}/private/{privDocId} {
      allow read: if isAdminUser();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // Users can write their own doc; admins can update any user (for approvals)
      allow create: if request.auth != null && request.auth.uid == userId;
      // SECURITY (C-03, 2026-09-02): a member must not be able to change their
      // own accountType (free self-upgrade to the Business tier — external
      // security review finding C-03). Tier changes happen via the business
      // sign-up + admin review flow; after creation only admins may change it.
      // All other own-doc updates (profile, presence, tokens, verifiedAt after
      // email verification) are unaffected.
      allow update: if request.auth != null
        && (isAdminUser()
          || (request.auth.uid == userId
            && request.resource.data.get('accountType', '') == resource.data.get('accountType', '')));
      allow delete: if request.auth != null && request.auth.uid == userId;

      // SECURITY (C-01, 2026-09-02): private member data (email, phone) lives in
      // this owner/admin-only subdocument, not the world-readable profile doc
      // (external security review finding C-01).
      match /private/{docId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == userId || isAdminUser());
      }

      // Legacy connections subcollection
      match /connections/{connectionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── User settings ────────────────────────────────
    match /userSettings/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Banned users ─────────────────────────────────
    // SECURITY (H3, 2026-07-05): write is admin-only. Was open to any
    // authenticated user — a banned user could self-unban by deleting their own
    // doc (incl. via "Delete My Data"), and anyone could ban anyone. Admin
    // moderation writes via isAdminUser(); dataPrivacy's cleanup deleteDoc is
    // already wrapped in a swallowed try/catch so self-serve deletion is
    // unaffected (banned users correctly can no longer wipe their ban). Move
    // account-deletion cleanup of these docs to a Cloud Function later.
    match /bannedUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }

    // ─── Disabled users ───────────────────────────────
    // SECURITY (H3, 2026-07-05): write is admin-only (see bannedUsers note).
    match /disabledUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }

    // ─── Top-level connections collection ──────────────
    match /connections/{connectionId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // ─── Posts (feed) ─────────────────────────────────
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Any authenticated user can update (needed for reactions)
      allow update: if request.auth != null;
      // Only the post author can delete
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.userId);

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Comment author can update (e.g. remove image) or delete their own comment
        allow update: if request.auth != null
          && request.auth.uid == resource.data.userId;
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId);
      }

      match /likes/{likeId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == likeId;
      }
    }

    // ─── Business listings ────────────────────────────
    match /businesses/{businessId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // SECURITY (H2, 2026-07-05): update stays broadly allowed because
      // legitimate any-user flows write here (posting a review updates the
      // rating aggregate; the 3-strike report flow sets isHidden). But the
      // TRUST fields (verified / verificationMethod) may only be changed by an
      // admin — previously any user could self-verify their own business by
      // flipping `verified:true`. The admin verify toggle runs under
      // isAdminUser(); owner edits and review/report writes never touch these
      // fields, so this is transparent to them. (Follow-up: field-lock ownerId
      // + move review/report aggregates server-side for full least-privilege.)
      // .get(field, default) is used so older docs missing these fields don't
      // error the comparison (which would deny legit review/report updates).
      allow update: if request.auth != null && (
        isAdminUser()
        || (request.resource.data.get('verified', false) == resource.data.get('verified', false)
            && request.resource.data.get('verificationMethod', '') == resource.data.get('verificationMethod', ''))
      );
      // Delete restricted to the owner or an admin (was any authenticated user).
      allow delete: if request.auth != null
        && (isAdminUser() || request.auth.uid == resource.data.get('ownerId', ''));

      // Analytics subcollection (daily event counters)
      match /analytics/{dateKey} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Q&A subcollection (#35 — public questions & answers)
      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }
    }

    // ─── Business Menu Items ────────────────────────
    match /businessMenuItems/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Catering Menu Items ──────────────────────
    match /cateringMenuItems/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Catering Orders ──────────────────────────
    // SB-40: Role-based authorization on status transitions
    match /cateringOrders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Allow customer to update their own orders (non-status fields)
        request.auth.uid == resource.data.customerId
        // Allow vendor (business owner) to update their business orders
        || request.auth.uid == get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId
        // Allow status transitions only if valid
        || (request.resource.data.status != resource.data.status &&
            isValidStatusTransition(resource.data.status, request.resource.data.status))
      );
      allow delete: if isAdminUser();

      // Helper to validate status transitions
      function isValidStatusTransition(currentStatus, newStatus) {
        return (
          (currentStatus == 'pending' && (newStatus == 'confirmed' || newStatus == 'cancelled'))
          || (currentStatus == 'confirmed' && (newStatus == 'preparing' || newStatus == 'cancelled'))
          || (currentStatus == 'preparing' && (newStatus == 'ready' || newStatus == 'cancelled'))
          || (currentStatus == 'ready' && (newStatus == 'out_for_delivery' || newStatus == 'cancelled'))
          || (currentStatus == 'out_for_delivery' && newStatus == 'delivered')
        );
      }

      // ── In-order messaging subcollection (customer ↔ vendor notes) ──
      match /notes/{noteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        // Allow update for read receipts (readBy/readAt) — only non-sender can mark as read
        allow update: if request.auth != null
          && request.auth.uid != resource.data.senderId;
        allow delete: if false;
      }
    }

    // ─── Catering Quote Requests (Phase 2 RFP) ────
    match /cateringQuoteRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdminUser();
    }

    // ─── Catering Quote Responses ──────────────────
    match /cateringQuoteResponses/{responseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdminUser();
    }

    // ─── Catering Favorites (Phase 6) ─────────────────
    match /cateringFavorites/{favId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ─── Catering Recurring Orders (Phase 6) ────────
    match /cateringRecurring/{recId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ─── Catering Order Templates (Phase 6) ─────────
    match /cateringTemplates/{tmplId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.creatorId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.creatorId;
    }

    // ─── Business Reviews ───────────────────────────
    match /businessReviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Business Orders ────────────────────────────
    match /businessOrders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Events ───────────────────────────────────────
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Any authenticated user can update (needed for RSVP, waitlist)
      allow update: if request.auth != null;
      // Only the event poster can delete
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.posterId || request.auth.uid == resource.data.createdBy || request.auth.uid == resource.data.userId);

      // Event comments / discussion thread
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    // ─── Housing listings (collection name: "listings") ─
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.posterId || request.auth.uid == resource.data.userId);

      // ─── Housing listing comments ─────────────────────
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    // ─── Legacy housing path ──────────────────────────
    match /housing/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ─── Forum threads ────────────────────────────────
    match /forumThreads/{threadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Any auth user can update (needed for voting, accepted reply)
      allow update: if request.auth != null;
      // Only the thread author can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      // Subcollection replies
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      }

      // Subcollection likes/votes
      match /likes/{likeId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      match /forumLikes/{voteId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // ─── Forum replies (top-level collection) ─────────
    match /forumReplies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Any auth user can update (needed for voting, accepted status)
      allow update: if request.auth != null;
      // Only the reply author can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      // Subcollection votes
      match /forumLikes/{voteId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // ─── Forum likes (top-level collection) ───────────
    match /forumLikes/{likeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Forum likes: collection-group READ (Session 49) ───────────
    // fetchMyForumVotes() uses collectionGroup('forumLikes'), which the
    // nested per-path matches above do NOT authorize — collection-group
    // queries need a /{path=**}/ match. Read-only: writes remain governed
    // by the specific per-path rules.
    match /{path=**}/forumLikes/{likeId} {
      allow read: if request.auth != null;
    }

    // ─── Comments: collection-group READ (SECURITY H-07, 2026-09-03) ─────
    // deleteMyData() uses collectionGroup('comments') where userId == uid to
    // find the user's own comments across posts/events/listings before account
    // deletion. Scoped to the requester's own comments; writes remain governed
    // by the specific per-path rules above.
    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ─── Calls (WebRTC signaling) ─────────────────────
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId
         || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.callerId
         || request.auth.uid == resource.data.calleeId);

      // ICE candidates subcollections
      match /callerCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }

    // ─── Group Calls (mesh WebRTC signaling) ─────────────
    match /groupCalls/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;

      // Per-pair signaling documents
      match /signals/{signalId} {
        allow read, write: if request.auth != null;

        // ICE candidates for each signal pair
        match /candidates/{candidateId} {
          allow read, write: if request.auth != null;
        }
      }
    }

    // ─── Messages / Conversations ─────────────────────
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      // SECURITY (M7, 2026-07-05): was `if request.auth != null` — any user
      // could delete anyone's conversation. Now participant-scoped.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // SECURITY (C4, 2026-07-05): the messages subcollection previously
      // allowed read/create/update/delete to ANY authenticated user — the
      // parent-doc participant check did NOT extend here, so anyone who knew a
      // (predictable, UID-derived) conversation ID could read/tamper/delete a
      // thread's messages. Now every op requires the caller be a participant of
      // the parent conversation. update/delete stay participant-scoped (not
      // sender-only) because pin/star/read-receipts/disappearing-cleanup are
      // performed by any participant, not just the message's sender.
      match /messages/{messageId} {
        function convParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid in convParticipants();
      }
    }

    // ─── Travel posts ─────────────────────────────────
    match /travelPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.posterId || request.auth.uid == resource.data.userId);
    }

    // ─── Legacy travel path ───────────────────────────
    match /travelListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ─── Marketplace listings ─────────────────────────
    match /marketplaceListings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.sellerId;
    }

    // ─── Marketplace comments ───────────────────────
    match /marketplaceComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ─── Announcements ────────────────────────────────
    // SECURITY (M3, 2026-07-05): write is admin-only (only the admin panel
    // creates/toggles/deletes announcements). Previously any authenticated user
    // could push an app-wide announcement.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }

    // ─── Moderation queue ─────────────────────────────
    match /moderationQueue/{itemId} {
      // SECURITY (H-05, 2026-09-02): reports are confidential to moderators
      // (external security review finding H-05) — READ and DELETE are admin-only.
      // CREATE/UPDATE stay open: reporters upsert an entry keyed by contentId
      // with blind increments (no reads needed); the 3-strike escalation runs in
      // the onModerationQueueWritten Cloud Function. Tracked risk: reportCount
      // inflation by a hostile user — admins review every item, and server-only
      // writes are staged with H4-create.
      allow read, delete: if isAdminUser();
      allow create, update: if request.auth != null;
    }

    // ─── Reports ──────────────────────────────────────
    match /reports/{reportId} {
      // SECURITY (H-05, 2026-09-02): reporter identities are confidential — read
      // is admin-only. Any signed-in member may still file a report.
      allow read: if isAdminUser();
      allow create: if request.auth != null;
    }

    // ─── Notifications (email/SMS/push queue — written by client, processed by Cloud Functions) ────
    // SECURITY (H4, 2026-07-05):
    //  - READ is now recipient-scoped (was `auth != null` — any user could read
    //    every notification, incl. others' content/PII). Safe: the noti list UI
    //    only ever reads the current user's own notifications.
    //  - CREATE remains open pending a Cloud Function callable, because the
    //    `processNotification` trigger fans these out to email/SMS/push and MANY
    //    client flows legitimately enqueue notifications today. Flipping this to
    //    `false` now would break notifications app-wide. TRACKED RISK: until the
    //    callable exists, a user can enqueue a notification to an arbitrary
    //    recipientId (spam/phishing on our infra). Mitigation plan: (1) a
    //    `requestNotification` callable that validates the sender↔recipient
    //    relationship + rate-limits, then (2) set create:false here. See report
    //    §5 H4 and functions/src/index.ts:processNotification.
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientId;
      // SECURITY (H-07, 2026-09-03): recipients may delete their own
      // notifications (needed by the account-deletion sweep).
      allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
    }

    // ─── Catering In-App Notifications ────────────────
    match /cateringNotifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientId;
      // SECURITY (H-07, 2026-09-03): recipients may delete their own
      // notifications (needed by the account-deletion sweep). Was `if false`.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.recipientId;
    }

    // ─── Vendor Image Audit Log (liability trail) ──────
    match /vendorImageAuditLog/{entryId} {
      allow read: if request.auth != null && isAdminUser();
      allow create: if request.auth != null;
      allow update, delete: if false; // Immutable audit trail
    }

    // ─── Notification Preferences (per-user settings) ──
    match /notificationPreferences/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ─── Notification Analytics (admin read-only, Cloud Functions write) ──
    match /notificationAnalytics/{docId} {
      allow read: if request.auth != null && isAdminUser();
      allow write: if false; // Only Cloud Functions write via admin SDK
    }

    // ─── User warnings ─────────────────────────────────
    match /userWarnings/{warningId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ─── Admin settings (legacy) ──────────────────────
    // SECURITY (M3, 2026-07-05): write is admin-only (no client write path
    // found; was open to any authenticated user).
    match /adminSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }
  }
}
